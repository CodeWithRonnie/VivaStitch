<div 
  class="collection-header {% if template.name == 'index' %}transparent{% else %}scrolled{% endif %}" 
  id="site-header">

  <button class="hamburger" onclick="toggleDrawer()">☰</button>

  <nav class="collection-nav">
    <a href="{{ routes.all_products_collection_url }}" class="{% if collection.handle == 'all' %}active{% endif %}">All</a>
    <a href="{{ routes.collections_url }}/Socks" class="{% if collection.handle == 'Socks' %}active{% endif %}">Socks</a>
    <a href="{{ routes.collections_url }}/Shirts" class="{% if collection.handle == 'Shirts' %}active{% endif %}">Shirts</a>
    <a href="{{ routes.collections_url }}/hoodies-1" class="{% if collection.handle == 'Hoodies' %}active{% endif %}">Hoodies</a>
  </nav>

  <h1 class="storeLogo"><a href="{{ routes.root_url }}">VivaStitch</a></h1>

  <div class="header-right">
    <a href="{{ routes.account_url }}">Account</a>
    <a href="{{ routes.cart_url }}">Bag({{ cart.item_count }})</a>
  </div>

  <div id="drawer" class="drawer">
    <div class="drawer-content">
      <button class="close-drawer" onclick="toggleDrawer()">✕</button>

      <ul class="drawer-links">
        <li><a href="{{ routes.all_products_collection_url }}">Shop All</a></li>
        <li><a href="{{ routes.collections_url }}/Socks">Socks</a></li>
        <li><a href="{{ routes.collections_url }}/Shirts">Shirts</a></li>
        <li><a href="{{ routes.collections_url }}/Hoodies">Hoodies</a></li>
        <li><a href="{{ routes.collections_url }}/gift-cards">Gift Cards</a></li>
      </ul>

      <div class="drawer-bottom">
        <a href="{{ routes.account_url }}">Account</a>
        <a href="/pages/contact">Contact</a>
      </div>
    </div>
  </div>
</div>

<script>
  // Toggle drawer open/close
  function toggleDrawer() {
    document.getElementById("drawer").classList.toggle("open");
  }

  // Switch header to solid on scroll
  window.addEventListener("scroll", function() {
    const header = document.getElementById("site-header");
    if (window.scrollY > 50) {
      header.classList.add("scrolled");
      header.classList.remove("transparent");
    } else if (window.location.pathname === "/") {
      // keep transparent only on homepage top
      header.classList.add("transparent");
      header.classList.remove("scrolled");
    }
  });
</script>

{% stylesheet %}
.collection-header {
  position: fixed;            
  top: 0;
  left: 0;
  width: 100%;
  padding: 15px 30px;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: 'Poppins', sans-serif;
  transition: background-color 0.3s ease, box-shadow 0.3s ease;
}

.storeLogo {
  order: 0;
  font-family: 'Brush Script MT', cursive;
  font-size: 40px;
  color: #000; 
  margin: 0;
}

.storeLogo a {
  text-decoration: none;
  color: inherit;
}

.collection-nav {
  display: flex;
  gap: 3px;
  flex-wrap: wrap; 
  flex: 1 1 0;
  justify-content: center;
}

.collection-nav a {
  padding: 8px 16px;
  border-radius: 6px;
  text-decoration: none;
  color: #333;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  transition: all 0.3s ease;
}

.collection-nav a:hover,
.collection-nav a.active {
  background-color: rgba(255,255,255,0.9);
  color: #151515ff; 
  transform: translateY(-2px);
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

.header-right {
  display: flex;
  gap: 12px;
  flex: 1 1 0;
  justify-content: flex-end;
}

.header-right a {
  padding: 8px 12px;
  border-radius: 6px;
  text-decoration: none;
  color: #333;
  font-weight: 500;
  transition: all 0.3s ease;
}

.header-right a:hover {
  color: #151515ff;
  transform: translateY(-2px);
}

/* Drawer styles */
.close-drawer {
  background: none;
  border: none;
  font-size: 24px;
  cursor: pointer;
  align-self: flex-end;
  margin-bottom: 20px;
}

.drawer {
  position: fixed;
  top: 0;
  left: -100%;
  width: 30%;
  height: 50%;
  background-color: #fff;
  box-shadow: 2px 0 8px rgba(0,0,0,0.2);
  transition: left 0.3s ease;
  z-index: 1100;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.drawer.open {
  left: 0;
}

/* Transparent over hero */
.collection-header.transparent {
  background: transparent;
  box-shadow: none;
}
.collection-header.transparent .collection-nav a,
.collection-header.transparent .header-right a,
.collection-header.transparent .storeLogo a {
  color: #fff;
}
.collection-header.transparent .storeLogo { color: #fff; }

/* Solid on scroll or non-home pages */
.collection-header.scrolled {
  background: #ffffff;
  box-shadow: 0 2px 6px rgba(0,0,0,0.08);
}
.collection-header.scrolled .collection-nav a,
.collection-header.scrolled .header-right a,
.collection-header.scrolled .storeLogo a {
  color: #333;
}
.collection-header.scrolled .storeLogo { color: #333; }

/* Push page content below header */
body { padding-top: 80px; }
{% endstylesheet %}
