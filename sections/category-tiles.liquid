<section class="category-tiles full-width">
  <div class="ct__inner">
    <div class="ct__grid">
      <a class="ct__tile" href="{{ section.settings.tile1_link | default: routes.collections_url | append: '/Shirts' }}">
        <div class="ct__media">
          {% if section.settings.tile1_image %}
            {{ section.settings.tile1_image | image_url: width: 1400 | image_tag: class: 'ct__img', alt: section.settings.tile1_title | escape }}
          {% endif %}
        </div>
        <div class="ct__label">{{ section.settings.tile1_title | default: 'Shirts' }}</div>
      </a>

      <a class="ct__tile" href="{{ section.settings.tile2_link | default: routes.collections_url | append: '/Socks' }}">
        <div class="ct__media">
          {% if section.settings.tile2_image %}
            {{ section.settings.tile2_image | image_url: width: 1400 | image_tag: class: 'ct__img', alt: section.settings.tile2_title | escape }}
          {% endif %}
        </div>
        <div class="ct__label">{{ section.settings.tile2_title | default: 'Socks' }}</div>
      </a>

      <a class="ct__tile" href="{{ section.settings.tile3_link | default: routes.collections_url | append: '/hoodies-1' }}">
        <div class="ct__media">
          {% if section.settings.tile3_image %}
            {{ section.settings.tile3_image | image_url: width: 1400 | image_tag: class: 'ct__img', alt: section.settings.tile3_title | escape }}
          {% endif %}
        </div>
        <div class="ct__label">{{ section.settings.tile3_title | default: 'Hoodies' }}</div>
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
  .ct__inner { padding: 24px; }
  .ct__grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 16px; }
  .ct__tile { position: relative; display: block; text-decoration: none; color: inherit; overflow: hidden; border-radius: 12px; }
  .ct__media { aspect-ratio: 16/10; background: #f2f2f2; }
  .ct__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ct__label { position: absolute; left: 12px; bottom: 12px; background: rgba(0,0,0,.55); color: #fff; padding: 8px 12px; font-weight: 800; letter-spacing: .3px; }
  @media (max-width: 900px){ .ct__grid { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "image_picker", "id": "tile1_image", "label": "Tile 1 image" },
    { "type": "text", "id": "tile1_title", "label": "Tile 1 title", "default": "Shirts" },
    { "type": "url", "id": "tile1_link", "label": "Tile 1 link" },

    { "type": "image_picker", "id": "tile2_image", "label": "Tile 2 image" },
    { "type": "text", "id": "tile2_title", "label": "Tile 2 title", "default": "Socks" },
    { "type": "url", "id": "tile2_link", "label": "Tile 2 link" },

    { "type": "image_picker", "id": "tile3_image", "label": "Tile 3 image" },
    { "type": "text", "id": "tile3_title", "label": "Tile 3 title", "default": "Hoodies" },
    { "type": "url", "id": "tile3_link", "label": "Tile 3 link" }
  ],
  "presets": [ { "name": "Category tiles" } ]
}
{% endschema %}


