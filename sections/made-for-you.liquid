<section class="made-for-you full-width">
  <div class="mf__inner">
    <div class="mf__media">
      {% if section.settings.image %}
        {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'mf__img', alt: section.settings.heading | escape }}
      {% endif %}
    </div>
    <div class="mf__content">
      <h2 class="mf__title">{{ section.settings.heading | default: 'Made for you' }}</h2>
      {% if section.settings.text != blank %}
        <p class="mf__text">{{ section.settings.text }}</p>
      {% endif %}
      {% if section.settings.cta_url %}
        <a class="mf__cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label | default: 'Shop Now' }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .mf__inner { display: grid; grid-template-columns: var(--content-grid); padding: 40px 24px; }
  .mf__inner > * { grid-column: 2; }
  .mf__media { border-radius: 16px; overflow: hidden; }
  .mf__img { width: 100%; height: auto; display: block; }
  .mf__content { margin-top: 16px; display: grid; gap: 10px; }
  .mf__title { margin: 0; font-size: 2rem; font-weight: 900; color: #0f172a; }
  .mf__text { margin: 0; color: #374151; }
  .mf__cta { width: fit-content; text-decoration: none; font-weight: 800; letter-spacing: .5px; padding: 12px 16px; border-radius: 10px; color: #fff; background: linear-gradient(90deg, var(--brand-600), var(--accent-600)); }
{% endstylesheet %}

{% schema %}
{
  "name": "Made for you",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for you" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Elevate your wardrobe with thoughtful fits and sustainable materials." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop Now" }
  ],
  "presets": [ { "name": "Made for you" } ]
}
{% endschema %}


