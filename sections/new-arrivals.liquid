<section class="new-arrivals full-width" data-section-id="{{ section.id }}">
  <div class="na__inner">

    <!-- Tabs -->
    <h2 class="new-arrivals">New Arrivals</h2>
    <div class="na__tabs">
      <button class="na__tab active" data-target="men">Men</button>
      <button class="na__tab" data-target="women">Women</button>
      <button class="na__tab" data-target="accessories">Accessories</button>
    </div>

    <!-- Men (mapped to Shirts) -->
    <div class="na__panel active" data-panel="men">
      <div class="na__scroll-wrapper">
        <button class="na__nav na__nav--prev" aria-label="Previous">&larr;</button>
        <div class="na__scroll">
          {% for product in collections['Shirts'].products limit: section.settings.limit %}
            <a class="na-card" href="{{ product.url }}">
              {% if product.featured_image %}
                <img class="na-card__img" src="{{ product.featured_image | image_url: width: 600, height: 750, crop: 'center' }}" alt="{{ product.title | escape }}">
              {% endif %}
              <div class="na-card__meta">
                <p class="na-card__title">{{ product.title }}</p>
                <p class="na-card__price">{{ product.price | money }}</p>
              </div>
            </a>
          {% endfor %}
        </div>
        <button class="na__nav na__nav--next" aria-label="Next">&rarr;</button>
      </div>
    </div>

    <!-- Women (mapped to Socks) -->
    <div class="na__panel" data-panel="women">
      <div class="na__scroll-wrapper">
        <button class="na__nav na__nav--prev" aria-label="Previous">&larr;</button>
        <div class="na__scroll">
          {% for product in collections['Socks'].products limit: section.settings.limit %}
            <a class="na-card" href="{{ product.url }}">
              {% if product.featured_image %}
                <img class="na-card__img" src="{{ product.featured_image | image_url: width: 600, height: 750, crop: 'center' }}" alt="{{ product.title | escape }}">
              {% endif %}
              <div class="na-card__meta">
                <p class="na-card__title">{{ product.title }}</p>
                <p class="na-card__price">{{ product.price | money }}</p>
              </div>
            </a>
          {% endfor %}
        </div>
        <button class="na__nav na__nav--next" aria-label="Next">&rarr;</button>
      </div>
    </div>

    <!-- Accessories (mapped to hoodies-1) -->
    <div class="na__panel" data-panel="accessories">
      <div class="na__scroll-wrapper">
        <button class="na__nav na__nav--prev" aria-label="Previous">&larr;</button>
        <div class="na__scroll">
          {% for product in collections['hoodies-1'].products limit: section.settings.limit %}
            <a class="na-card" href="{{ product.url }}">
              {% if product.featured_image %}
                <img class="na-card__img" src="{{ product.featured_image | image_url: width: 600, height: 750, crop: 'center' }}" alt="{{ product.title | escape }}">
              {% endif %}
              <div class="na-card__meta">
                <p class="na-card__title">{{ product.title }}</p>
                <p class="na-card__price">{{ product.price | money }}</p>
              </div>
            </a>
          {% endfor %}
        </div>
        <button class="na__nav na__nav--next" aria-label="Next">&rarr;</button>
      </div>
    </div>

  </div>
</section>

<style>
.new-arrivals{
 text-align: center;
  font-size: 2rem;
  margin-bottom: 25px;
  color: #3b3939ff;
}

.na__tabs {
  display: flex;
  gap: 20px;
  margin-bottom: 20px;
}
.na__tab {
  padding: 10px 18px;
  cursor: pointer;
  background: #f7f7f7;
  border: none;
  border-radius: 20px;
  font-weight: 600;
  transition: background 0.3s ease;
}
.na__tab.active,
.na__tab:hover {
  background: #000;
  color: #fff;
}

.na__panel { display: none; }
.na__panel.active { display: block; }

.na__scroll-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.na__scroll {
  display: flex;
  gap: 20px;
  padding: 10px 0;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth; /* smooth animation */
}
.na__scroll::-webkit-scrollbar { display: none; }

.na-card {
  flex: 0 0 auto;
  width: 450px;
  text-align: center;
  scroll-snap-align: start;
  transition: transform 0.2s ease;
}
.na-card:hover { transform: scale(1.05); }
.na-card__img {
  width: 100%;
  border-radius: 10px;
}
.na-card__title { font-size: 14px; margin-top: 8px; color: #3b3939ff; }
.na-card__price { font-size: 13px; color: #3b3939ff; }

.na__nav {
  position: absolute;
  top: 40%;
  transform: translateY(-50%);
  background: rgba(0,0,0,0.6);
  border: none;
  color: #fff;
  font-size: 1.5rem;
  padding: 10px 14px;
  border-radius: 50%;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
  z-index: 5;
}
.na__nav:hover {
  background: rgba(0,0,0,0.8);
  transform: translateY(-50%) scale(1.1);
}
.na__nav--prev { left: 5px; }
.na__nav--next { right: 5px; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function(){
  var root = document.querySelector('[data-section-id="{{ section.id }}"]');

  // Tabs
  var tabs = root.querySelectorAll('.na__tab');
  var panels = root.querySelectorAll('.na__panel');
  tabs.forEach(function(tab){
    tab.addEventListener('click', function(){
      tabs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      var target = tab.getAttribute('data-target');
      root.querySelector('.na__panel[data-panel="'+target+'"]').classList.add('active');
    });
  });

  // Scroll navigation
  var navButtons = root.querySelectorAll('.na__nav');
  navButtons.forEach(function(btn){
    btn.addEventListener('click', function(){
      var wrapper = btn.closest('.na__scroll-wrapper');
      var scroller = wrapper.querySelector('.na__scroll');
      var cardWidth = scroller.querySelector('.na-card')?.offsetWidth || 220;
      var gap = parseInt(window.getComputedStyle(scroller).gap) || 20;
      var scrollAmount = cardWidth + gap;

      if (btn.classList.contains('na__nav--next')) {
        scroller.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      } else {
        scroller.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "New Arrivals Tabbed",
  "settings": [
    {
      "type": "number",
      "id": "limit",
      "label": "Products per tab",
      "default": 10
    }
  ],
  "presets": [
    { "name": "New Arrivals Tabbed" }
  ]
}
{% endschema %}
