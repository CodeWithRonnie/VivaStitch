<section class="new-arrivals full-width" data-section-id="{{ section.id }}"> 
  <div class="na__inner">

    <!-- Tabs -->
    <h2 class="na__heading">New Arrivals</h2>
    <div class="na__tabs">
      <button class="na__tab active" data-target="men">Men</button>
      <button class="na__tab" data-target="women">Women</button>
      <button class="na__tab" data-target="accessories">Accessories</button>
    </div>

    <!-- Panels -->
    {% assign collections_map = "men:Shirts,women:Socks,accessories:hoodies-1" | split: "," %}
    {% for pair in collections_map %}
      {% assign parts = pair | split: ":" %}
      {% assign key = parts[0] %}
      {% assign collection_name = parts[1] %}
      <div class="na__panel {% if forloop.first %}active{% endif %}" data-panel="{{ key }}">
        <div class="na__scroll-wrapper">
          <button class="na__nav na__nav--prev" aria-label="Previous">&larr;</button>
          <div class="na__scroll">
            {% for product in collections[collection_name].products limit: section.settings.limit %}
              <a class="na-card" href="{{ product.url }}">
                {% if product.featured_image %}
                  <div class="na-card__img-wrapper">
                    <img class="na-card__img" src="{{ product.featured_image | image_url: width: 600, height: 750, crop: 'center' }}" alt="{{ product.title | escape }}">
                    
                  </div>
                {% endif %}
                <div class="na-card__meta">
                  <p class="na-card__title">{{ product.title }}</p>
                  <p class="na-card__price">{{ product.price | money }}</p>
                </div>
              </a>
            {% endfor %}
          </div>
          <button class="na__nav na__nav--next" aria-label="Next">&rarr;</button>
        </div>
      </div>
    {% endfor %}

  </div>
</section>

<style>
/* Section heading */
.na__heading {
  text-align: center;
  font-size: 2.5rem;
  font-weight: 900;
  margin-bottom: 30px;
  color: #111;
}

/* Tabs - black rectangles */
.na__tabs {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-bottom: 25px;
}
.na__tab {
  padding: 20px 100px;
  font-size: 1rem;
  font-weight: 700;
  border-radius: 0; /* rectangle */
  border: none;
  cursor: pointer;
  background: #111;
  color: #fff;
  transition: transform 0.2s, background 0.2s;
}
.na__tab:hover { background: #333; }
.na__tab.active { background: #000; }

/* Panels */
.na__panel { display: none; }
.na__panel.active { display: block; }

/* Scroll wrapper */
.na__scroll-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

/* Scrollable cards */
.na__scroll {
  display: flex;
  gap: 40px;
  padding: 15px 0;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  z-index: 1; /* make sure buttons overlay works */
}
.na__scroll::-webkit-scrollbar { display: none; }

/* Product Card - BabyBoo style */
.na-card {
  flex: 0 0 auto;
  width: 500px;
  scroll-snap-align: start;
  text-decoration: none;
  color: inherit;
  position: relative; /* allow hover CTA without blocking links */
  transition: transform 0.3s ease;
}
.na-card:hover { transform: scale(1.03); }

.na-card__img-wrapper {
  position: relative;
  width: 100%;
  overflow: hidden;
}
.na-card__img {
  width: 100%;
  height: 380px;
  object-fit: cover;
  display: block;
}

/* Hover overlay CTA - pointer-events none on container to fix clicks */

.na-card__img-wrapper:hover .na-card__cta {
  opacity: 1;
  transform: translateX(-50%) translateY(-5px);
}

.na-card__meta {
  margin-top: 10px;
  text-align: center;
}
.na-card__title {
  font-size: 1.1rem;
  font-weight: 700;
  color: #111;
  margin: 6px 0 2px;
}
.na-card__price {
  font-size: 1rem;
  font-weight: 700;
  color: #f59e0b;
}

/* Navigation buttons */
.na__nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: #000;
  color: #fff;
  font-size: 2rem;
  border-radius: 0;
  border: none;
  padding: 5px 14px;
  cursor: pointer;
  transition: transform 0.2s, background 0.2s;
  opacity: 0.8;
  z-index: 10; /* above cards */
}
.na__nav:hover {
  transform: translateY(-50%) scale(1.1);
  background: #262525ff;
  
}
.na__nav--prev { left: -10px; }
.na__nav--next { right: -10px; }

/* Responsive */
@media (max-width: 1024px) { .na-card { width: 250px; } }
@media (max-width: 768px) { 
  .na-card { width: 200px; }
  .na__heading { font-size: 2rem; }
  .na__tab { padding: 10px 20px; font-size: 0.95rem; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function(){
  var root = document.querySelector('[data-section-id="{{ section.id }}"]');

  // Tabs
  var tabs = root.querySelectorAll('.na__tab');
  var panels = root.querySelectorAll('.na__panel');
  tabs.forEach(function(tab){
    tab.addEventListener('click', function(){
      tabs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      var target = tab.getAttribute('data-target');
      root.querySelector('.na__panel[data-panel="'+target+'"]').classList.add('active');
    });
  });

  // Scroll navigation
  var navButtons = root.querySelectorAll('.na__nav');
  navButtons.forEach(function(btn){
    btn.addEventListener('click', function(){
      var wrapper = btn.closest('.na__scroll-wrapper');
      var scroller = wrapper.querySelector('.na__scroll');
      var cardWidth = scroller.querySelector('.na-card')?.offsetWidth || 220;
      var gap = parseInt(window.getComputedStyle(scroller).gap) || 20;
      var scrollAmount = cardWidth + gap;

      if (btn.classList.contains('na__nav--next')) {
        scroller.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      } else {
        scroller.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      }
    });
  });
});
</script>
